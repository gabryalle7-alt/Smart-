              private lateinit var etPickup: EditText
              private lateinit var etTrip: EditText
              private lateinit var etPrice: EditText
              private lateinit var tvStatus: TextView
              private lateinit var tvResult: TextView
              private lateinit var tvConfig: TextView

              private val handler = Handler(Looper.getMainLooper())
              private val calcRunnable = Runnable { calculate() }
              private var ignoreWatcher = false

              private val watcher = object : TextWatcher {
                  override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
                  override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                      if (ignoreWatcher) return
                      handler.removeCallbacks(calcRunnable)
                      handler.postDelayed(calcRunnable, 250L)
                  }
                  override fun afterTextChanged(s: Editable?) {}
              }

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  setContentView(R.layout.activity_main)

                  etPickup = findViewById(R.id.etPickup)
                  etTrip   = findViewById(R.id.etTrip)
                  etPrice  = findViewById(R.id.etPrice)
                  tvStatus = findViewById(R.id.tvStatus)
                  tvResult = findViewById(R.id.tvResult)
                  tvConfig = findViewById(R.id.tvConfig)

                  etPickup.addTextChangedListener(watcher)
                  etTrip.addTextChangedListener(watcher)
                  etPrice.addTextChangedListener(watcher)

                  findViewById<Button>(R.id.btnCalc).setOnClickListener { calculate() }
                  findViewById<Button>(R.id.btnSettings).setOnClickListener {
                      startActivity(Intent(this, SettingsActivity::class.java))
                  }
                  findViewById<Button>(R.id.btnSetup).setOnClickListener {
                      startActivity(Intent(this, SetupActivity::class.java))
                  }
                  findViewById<Button>(R.id.btnAccessibility).setOnClickListener {
                      if (!Settings.canDrawOverlays(this)) {
                          Toast.makeText(this,
                              "Acorda mai intai permisiunea Afisare peste alte aplicatii",
                              Toast.LENGTH_LONG).show()
                      }
                      startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                  }
                  findViewById<Button>(R.id.btnOverlay).setOnClickListener {
                      startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                          Uri.parse("package:" + packageName)))
                  }
              }

              override fun onResume() {
                  super.onResume()
                  updateConfigSummary()
                  val offers = getSharedPreferences("offers", MODE_PRIVATE)
                  if (offers.getBoolean("fresh", false)) {
                      ignoreWatcher = true
                      etPickup.setText(offers.getFloat("pickupKm", 0f).toString())
                      etTrip.setText(offers.getFloat("tripKm", 0f).toString())
                      etPrice.setText(offers.getFloat("price", 0f).toString())
                      ignoreWatcher = false
                      offers.edit().putBoolean("fresh", false).apply()
                      calculate()
                  }
              }

              private fun calculate() {
                  val pp = etPickup.text.toString().toFloatOrNull() ?: 0f
                  val t  = etTrip.text.toString().toFloatOrNull() ?: 0f
                  val pr = etPrice.text.toString().toFloatOrNull() ?: 0f

                  if (pp == 0f && t == 0f && pr == 0f) {
                      tvStatus.text = "Introdu datele cursei"
                      tvStatus.setTextColor(Color.parseColor("#888888"))
                      tvResult.text = ""
                      return
                  }

                  val offer = OfferParser.Offer(
                      priceRon = pr, pickupKm = pp, tripKm = t,
                      pickupMinutes = null, tripMinutes = null,
                      pickupEstimated = false, tripEstimated = false
                  )
                  val r = Calc.compute(this, offer)
                  tvStatus.text = r.text.substringBefore('\\n')
                  tvStatus.setTextColor(r.color)
                  tvResult.text = r.text
                  tvResult.setTextColor(r.color)
              }

              private fun updateConfigSummary() {
                  val p = getSharedPreferences("cfg", MODE_PRIVATE)
                  tvConfig.text = "Prag: %.1f RON/km · %.0f RON/h  |  Benzina %.2f · %.1fL/100 · Com. %.0f%%"
                      .format(
                          p.getFloat("minPerKm", 2.5f),
                          p.getFloat("minPerHour", 45f),
                          p.getFloat("fuelPrice", 7.5f),
                          p.getFloat("consumption", 7f),
                          p.getFloat("commission", 20f)
                      )
              }

              override fun onDestroy() {
                  handler.removeCallbacks(calcRunnable)
                  super.onDestroy()
              }
          }
