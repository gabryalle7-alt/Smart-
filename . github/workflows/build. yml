name: Build ProfitRide APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install Android SDK
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null 2>&1 || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "platforms;android-34" "build-tools;34.0.0"

      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.2

      - name: Create project files with Python
        run: |
          python3 - <<'PYEOF'
          import os

          def w(path, text):
              d = os.path.dirname(path)
              if d: os.makedirs(d, exist_ok=True)
              with open(path, 'w', encoding='utf-8') as f:
                  f.write(text.strip() + '\n')

          w('README.md', '''
          # ProfitRide

          Calculator de profit pentru curse Bolt/Uber, optimizat pentru **Honor Magic 5** (MagicOS).

          ## Instalare APK

          1. Descarca `app-debug.apk` din GitHub Actions -> rularea curenta -> **Artifacts** -> `ProfitRide-APK`
          2. Transfera pe telefon (USB / Google Drive / e-mail)
          3. Deschide fisierul -> permite **"Instalare din surse necunoscute"** daca iti cere
          4. Instaleaza si deschide aplicatia

          ## Setup obligatoriu pe Honor Magic 5 (MagicOS)

          MagicOS inchide agresiv serviciile de fundal. **Fara acesti pasi, overlay-ul nu va aparea.**

          ### 1. Afisare peste alte aplicatii
          - In app: buton **"Permite afisare peste alte aplicatii"** -> activeaza
          - Sau: Setari -> Aplicatii -> ProfitRide -> **Afisare ca pop-up** -> ON

          ### 2. Serviciu de accesibilitate
          - In app: buton **"Activeaza citirea automata"** -> ProfitRide -> **Activ**

          ### 3. Baterie fara restrictii (CRITIC pe Honor)
          - Setari -> Baterie -> **Lansare aplicatii** -> ProfitRide -> **Gestioneaza manual**
            - Bifeaza: Lansare automata, Lansare secundara, Rulare in fundal
          - Setari -> Aplicatii -> ProfitRide -> **Consum baterie** -> **Fara restrictii**

          ### 4. Voce romana (pentru anunturi)
          - Setari -> Limba si regiune -> **Iesire text in vorbire** -> Motor preferat -> **Google TTS**
          - Instaleaza pachetul de limba **Romana**

          ## Utilizare

          - **Automat**: deschide Bolt/Uber -> cand apare o oferta, overlay negru apare cu rezultatul
          - **Manual**: tasteaza km/tarif in app - calcul live in timp ce scrii
          - Verde = profitabil, Galben = mediu, Rosu = neprofitabil
          - Apasa pe overlay ca sa-l inchizi sau trage-l unde vrei

          ## Istoric

          Fiecare oferta e salvata in `/data/data/ro.profitride/files/offers.csv`
          ''')

          w('local.properties', f'sdk.dir={os.environ["ANDROID_HOME"]}')

          w('gradle.properties', '''
          android.useAndroidX=true
          org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
          ''')

          w('settings.gradle', '''
          pluginManagement {
              repositories { google(); mavenCentral(); gradlePluginPortal() }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories { google(); mavenCentral() }
          }
          rootProject.name = "ProfitRide"
          include ':app'
          ''')

          w('build.gradle', '''
