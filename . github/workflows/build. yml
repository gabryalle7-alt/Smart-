          w('app/src/main/java/ro/profitride/OfferParser.kt', '''
          package ro.profitride

          import kotlin.math.abs

          object OfferParser {

              data class Offer(
                  val priceRon: Float,
                  val pickupKm: Float,
                  val tripKm: Float,
                  val pickupMinutes: Float?,
                  val tripMinutes: Float?,
                  val pickupEstimated: Boolean,
                  val tripEstimated: Boolean
              )

              private val priceRe = Regex(
                  """(\\d+(?:[.,]\\d+)?)\\s*(?:RON|lei)\\b(?!\\s*/\\s*km)""",
                  RegexOption.IGNORE_CASE
              )
              private val minRe = Regex("""(\\d+(?:[.,]\\d+)?)\\s*min""", RegexOption.IGNORE_CASE)
              private val kmRe  = Regex("""(\\d+(?:[.,]\\d+)?)\\s*km""",  RegexOption.IGNORE_CASE)

              private val pickupWords = listOf("away", "depart", "pickup", "preluare", "la tine")
              private val tripWords   = listOf("trip", "ride", "curs", "distan", "destina")

              fun parse(text: String, avgSpeedKmh: Float = 25f): Offer? {
                  val speed = if (avgSpeedKmh >= 5f) avgSpeedKmh else 25f

                  val price = priceRe.findAll(text)
                      .mapNotNull { it.groupValues[1].replace(',', '.').toFloatOrNull() }
                      .filter { it in 1f..2000f }
                      .maxOrNull() ?: return null

                  fun ents(re: Regex): List<Pair<Float, Int>> =
                      re.findAll(text).mapNotNull { m ->
                          m.groupValues[1].replace(',', '.').toFloatOrNull()?.let { it to m.range.first }
                      }.toList()

                  val mins = ents(minRe)
                  val kms  = ents(kmRe)
                  if (mins.isEmpty() && kms.isEmpty()) return null

                  val lower = text.lowercase()
                  fun nearestWordDist(pos: Int, words: List<String>): Int {
                      var best = Int.MAX_VALUE
                      for (w in words) {
                          var i = lower.indexOf(w)
                          while (i >= 0) {
                              val d = abs(i - pos)
                              if (d < best) best = d
                              i = lower.indexOf(w, i + 1)
                          }
                      }
                      return best
                  }
                  fun classify(pos: Int): Int {
                      val p = nearestWordDist(pos, pickupWords)
                      val t = nearestWordDist(pos, tripWords)
                      val hp = p <= 60
                      val ht = t <= 60
                      return when {
                          hp && !ht -> 1
                          ht && !hp -> 2
                          hp && ht -> if (p <= t) 1 else 2
                          else -> 0
                      }
                  }

                  val pickupKms = kms.filter { classify(it.second) == 1 }.sortedBy { it.second }
                  val tripKms   = kms.filter { classify(it.second) == 2 }.sortedBy { it.second }
                  val unclass   = kms.filter { classify(it.second) == 0 }.sortedBy { it.second }

                  var pickupKm: Pair<Float, Int>? = pickupKms.firstOrNull()
                  var tripKm:   Pair<Float, Int>? = tripKms.firstOrNull()
                  for (k in unclass) {
                      if (pickupKm == null) { pickupKm = k; continue }
                      if (tripKm == null)   { tripKm = k;   continue }
                  }
                  if (pickupKm != null && tripKm == null) {
                      tripKm = pickupKm; pickupKm = null
                  }

                  val usedMins = mutableSetOf<Int>()
                  fun attach(km: Pair<Float, Int>?): Float? {
                      if (km == null) return null
                      val cands = mins.filter { it.second !in usedMins }
                      if (cands.isEmpty()) return null
                      val best = cands.minByOrNull { abs(it.second - km.second) } ?: return null
                      if (abs(best.second - km.second) > 100) return null
                      usedMins.add(best.second)
                      return best.first
                  }
                  var pickupMin = attach(pickupKm)
                  var tripMin   = attach(tripKm)

                  if (pickupKm == null || tripKm == null) {
                      for (m in mins) {
                          if (m.second in usedMins) continue
                          when (classify(m.second)) {
                              1 -> if (pickupKm == null && pickupMin == null) {
                                  pickupMin = m.first; usedMins.add(m.second)
                              }
                              2 -> if (tripKm == null && tripMin == null) {
                                  tripMin = m.first; usedMins.add(m.second)
                              }
                          }
                      }
                  }

                  var pKm = pickupKm?.first ?: 0f
                  var tKm = tripKm?.first   ?: 0f
                  var pEst = false
                  var tEst = false
                  if (pKm == 0f && pickupMin != null) { pKm = pickupMin * speed / 60f; pEst = true }
                  if (tKm == 0f && tripMin   != null) { tKm = tripMin   * speed / 60f; tEst = true }
                  if (pKm == 0f && tKm == 0f) return null

                  return Offer(price, pKm, tKm, pickupMin, tripMin, pEst, tEst)
              }
          }
          ''')

          w('app/src/main/java/ro/profitride/Calc.kt', '''
          package ro.profitride

          import android.content.Context
          import android.graphics.Color

          object Calc {
              data class Result(
                  val text: String,
                  val color: Int,
                  val profitPerKm: Float,
                  val profitPerHour: Float,
                  val speech: String
              )

              private val GREEN  = Color.parseColor("#4CAF50")
              private val YELLOW = Color.parseColor("#FFEB3B")
              private val RED    = Color.parseColor("#FF5252")

              fun compute(ctx: Context, o: OfferParser.Offer): Result {
                  val p = ctx.getSharedPreferences("cfg", Context.MODE_PRIVATE)
                  val fuelPrice    = p.getFloat("fuelPrice", 7.5f)
                  val consumption  = p.getFloat("consumption", 7f)
                  val commission   = p.getFloat("commission", 20f)
                  val extraPerKm   = p.getFloat("extraCost", 0.5f)
                  val minPerKm     = p.getFloat("minPerKm", 2.5f)
                  val minPerHour   = p.getFloat("minPerHour", 45f)
                  val returnPct    = p.getFloat("returnPercent", 0f) / 100f
                  val vatPayer     = p.getBoolean("vatPayer", false)
                  val avgSpeed     = p.getFloat("avgSpeedKmh", 25f).let { if (it >= 5f) it else 25f }

                  val returnKm = if (o.tripKm > 15f) o.tripKm * returnPct else 0f
                  val totalKm  = o.pickupKm + o.tripKm + returnKm

                  val commissionCut = o.priceRon * commission / 100f * (if (vatPayer) 1.19f else 1f)
                  val fuelCost  = totalKm / 100f * consumption * fuelPrice
                  val extraCost = totalKm * extraPerKm
                  val net       = o.priceRon - commissionCut - fuelCost - extraCost
                  val perKm     = if (totalKm > 0f) net / totalKm else 0f

                  val totalMin = (o.pickupMinutes ?: (o.pickupKm / avgSpeed * 60f)) +
                                 (o.tripMinutes   ?: (o.tripKm   / avgSpeed * 60f))
                  val perHour = if (totalMin > 0f) net / (totalMin / 60f) else 0f

                  val (label, color) = when {
                      perHour >= minPerHour * 1.2f && perKm >= minPerKm -> "PROFITABIL"   to GREEN
                      perHour >= minPerHour        && perKm >= minPerKm * 0.8f -> "MEDIU" to YELLOW
                      else -> "NEPROFITABIL" to RED
                  }

                  val est = if (o.pickupEstimated || o.tripEstimated) " (est.)" else ""
                  val pMinStr = o.pickupMinutes?.let { "${it.toInt()}min" } ?: "~"
                  val tMinStr = o.tripMinutes?.let   { "${it.toInt()}min" } ?: "~"

                  val text = """
                      [%s]
                      -----------------
                      Preluare: %.1f km%s | %s
                      Cursa:    %.1f km%s | %s
                      Total:    %.1f km | %d min
                      Tarif:    %.2f RON
                      -----------------
                      NET:     %.2f RON
                      RON/km:  %.2f  (prag %.2f)
                      RON/h:   %.0f  (prag %.0f)
                  """.trimIndent().format(
                      label,
                      o.pickupKm, est, pMinStr,
                      o.tripKm,   est, tMinStr,
                      totalKm, totalMin.toInt(), o.priceRon,
                      net, perKm, minPerKm, perHour, minPerHour
                  )

                  val speech = when (label) {
                      "PROFITABIL" -> "Profitabil. ${perKm.toInt()} lei pe kilometru. ${perHour.toInt()} lei pe ora."
