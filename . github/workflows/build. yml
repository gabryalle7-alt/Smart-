          w('app/src/main/java/ro/profitride/OfferReader.kt', r'''
          package ro.profitride

          import android.accessibilityservice.AccessibilityService
          import android.content.BroadcastReceiver
          import android.content.Context
          import android.content.Intent
          import android.content.IntentFilter
          import android.graphics.Color
          import android.graphics.PixelFormat
          import android.graphics.Typeface
          import android.os.Build
          import android.os.Handler
          import android.os.Looper
          import android.os.SystemClock
          import android.os.VibrationEffect
          import android.os.Vibrator
          import android.os.VibratorManager
          import android.speech.tts.TextToSpeech
          import android.view.Gravity
          import android.view.MotionEvent
          import android.view.View
          import android.view.WindowManager
          import android.view.accessibility.AccessibilityEvent
          import android.view.accessibility.AccessibilityNodeInfo
          import android.widget.LinearLayout
          import android.widget.TextView
          import androidx.core.content.ContextCompat
          import java.util.Locale

          class OfferReader : AccessibilityService() {

              private var overlay: View? = null
              private lateinit var wm: WindowManager
              private val handler = Handler(Looper.getMainLooper())
              private val autoDismiss = Runnable { removeOverlay() }

              private var tts: TextToSpeech? = null
              private var vibrator: Vibrator? = null

              private val sb = StringBuilder(2048)
              private var lastParseAt = 0L
              private var lastKey = ""

              private val screenOff = object : BroadcastReceiver() {
                  override fun onReceive(c: Context?, i: Intent?) {
                      if (i?.action == Intent.ACTION_SCREEN_OFF) removeOverlay()
                  }
              }

              override fun onServiceConnected() {
                  super.onServiceConnected()
                  wm = getSystemService(WINDOW_SERVICE) as WindowManager
                  vibrator = if (Build.VERSION.SDK_INT >= 31)
                      (getSystemService(VIBRATOR_MANAGER_SERVICE) as VibratorManager).defaultVibrator
                  else @Suppress("DEPRECATION") getSystemService(VIBRATOR_SERVICE) as Vibrator

                  tts = TextToSpeech(this) { status ->
                      if (status == TextToSpeech.SUCCESS) tts?.language = Locale("ro", "RO")
                  }
                  try {
                      ContextCompat.registerReceiver(this, screenOff,
                          IntentFilter(Intent.ACTION_SCREEN_OFF),
                          ContextCompat.RECEIVER_NOT_EXPORTED)
                  } catch (_: Exception) {}
              }

              override fun onAccessibilityEvent(event: AccessibilityEvent?) {
                  if (event == null) return

                  val pkg = event.packageName?.toString()?.lowercase() ?: return
                  if (!(pkg.contains("bolt") || pkg.contains("uber") || pkg.contains("free"))) return

                  val now = SystemClock.elapsedRealtime()
                  if (now - lastParseAt < 500L) return
                  lastParseAt = now

                  val root = rootInActiveWindow ?: return
                  sb.setLength(0)
                  collect(root, sb, 0)
                  if (sb.isEmpty()) return

                  val offer = OfferParser.parse(sb.toString(), avgSpeed()) ?: return
                  val key = offer.priceRon.toString() + "|" + offer.pickupKm + "|" + offer.tripKm
                  if (key == lastKey) return
                  lastKey = key

                  val result = Calc.compute(this, offer)

                  getSharedPreferences("offers", Context.MODE_PRIVATE).edit()
                      .putFloat("pickupKm", offer.pickupKm)
                      .putFloat("tripKm", offer.tripKm)
                      .putFloat("price", offer.priceRon)
                      .putBoolean("fresh", true)
                      .apply()

                  try {
                      openFileOutput("offers.csv", Context.MODE_APPEND).bufferedWriter().use {
                          it.appendLine("" + System.currentTimeMillis() + "," +
                              offer.priceRon + "," + offer.pickupKm + "," +
                              offer.tripKm + "," + result.profitPerKm + "," + result.profitPerHour)
                      }
                  } catch (_: Exception) {}

                  showOverlay(result)
                  speak(result)
                  vibrate(result.color)
              }

              private fun avgSpeed(): Float {
                  val v = getSharedPreferences("cfg", MODE_PRIVATE).getFloat("avgSpeedKmh", 25f)
                  return if (v >= 5f) v else 25f
              }

              private fun collect(node: AccessibilityNodeInfo?, sb: StringBuilder, depth: Int) {
                  if (node == null || depth > 25 || sb.length > 8000) return
                  node.text?.let { sb.append(it).append('\n') }
                  node.contentDescription?.let { sb.append(it).append('\n') }
                  for (i in 0 until node.childCount) collect(node.getChild(i), sb, depth + 1)
              }

              private fun speak(r: Calc.Result) {
                  if (!getSharedPreferences("cfg", MODE_PRIVATE).getBoolean("ttsEnabled", true)) return
                  tts?.speak(r.speech, TextToSpeech.QUEUE_FLUSH, null, "offer")
              }

              private fun vibrate(color: Int) {
                  val v = vibrator ?: return
                  val ms = when (color) {
                      Color.parseColor("#4CAF50") -> 120L
                      Color.parseColor("#FFEB3B") -> 250L
                      else                        -> 500L
                  }
                  if (Build.VERSION.SDK_INT >= 26)
                      v.vibrate(VibrationEffect.createOneShot(ms, VibrationEffect.DEFAULT_AMPLITUDE))
                  else @Suppress("DEPRECATION") v.vibrate(ms)
              }

              private fun showOverlay(r: Calc.Result) {
                  removeOverlay()
                  val container = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setBackgroundColor(Color.BLACK)
                      setPadding(30, 20, 30, 30)
                      setOnTouchListener(dragListener())
                  }
                  val close = TextView(this).apply {
                      text = "\u00d7"
                      setTextColor(Color.WHITE)
                      textSize = 20f
                      gravity = Gravity.END
                      setOnClickListener { removeOverlay() }
                  }
                  val body = TextView(this).apply {
                      text = r.text
                      setTextColor(r.color)
                      textSize = 12f
                      typeface = Typeface.MONOSPACE
                  }
                  container.addView(close)
                  container.addView(body)

                  val type = if (Build.VERSION.SDK_INT >= 26)
                      WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
                  else @Suppress("DEPRECATION") WindowManager.LayoutParams.TYPE_PHONE

                  val params = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.WRAP_CONTENT,
                      WindowManager.LayoutParams.WRAP_CONTENT,
                      type,
                      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
                      PixelFormat.TRANSLUCENT
                  ).apply { gravity = Gravity.TOP or Gravity.START; x = 20; y = 120 }

                  try {
                      wm.addView(container, params)
                      overlay = container
                      container.tag = params
                      handler.postDelayed(autoDismiss, 20_000L)
                  } catch (_: Exception) {}
              }

              private fun dragListener(): View.OnTouchListener {
                  var startX = 0; var startY = 0
                  var touchX = 0f; var touchY = 0f
                  var moved = false
                  return View.OnTouchListener { v, e ->
                      val params = v.tag as? WindowManager.LayoutParams ?: return@OnTouchListener false
                      when (e.action) {
                          MotionEvent.ACTION_DOWN -> {
                              startX = params.x; startY = params.y
                              touchX = e.rawX; touchY = e.rawY
                              moved = false; true
                          }
                          MotionEvent.ACTION_MOVE -> {
                              val dx = (e.rawX - touchX).toInt()
                              val dy = (e.rawY - touchY).toInt()
                              if (dx * dx + dy * dy > 100) moved = true
                              if (moved) {
                                  params.x = startX + dx
                                  params.y = startY + dy
                                  try { wm.updateViewLayout(v, params) } catch (_: Exception) {}
                              }
                              true
                          }
                          MotionEvent.ACTION_UP -> {
                              if (!moved) removeOverlay()
                              true
                          }
                          else -> false
                      }
                  }
              }

              private fun removeOverlay() {
                  handler.removeCallbacks(autoDismiss)
                  overlay?.let { try { wm.removeView(it) } catch (_: Exception) {} }
                  overlay = null
              }

              override fun onInterrupt() { removeOverlay() }

              override fun onDestroy() {
                  removeOverlay()
                  try { unregisterReceiver(screenOff) } catch (_: Exception) {}
                  tts?.stop(); tts?.shutdown(); tts = null
                  super.onDestroy()
              }
          }
          ''')
